# Скопируйте в корневой `.env` (файл не коммитится).
# Единая инструкция: docs/setup-and-configuration.md
# Продуктовая конфигурация: deployment.manifest.json, worker.runtime.manifest.json, geo.enrichers.manifest.json

# --- dotenv-vault (опционально: зашифрованный `.env.vault`, ключ вне git) ---
DOTENV_KEY=

# --- Node / API ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (docker-compose + api + worker db mode) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://radar:radar@127.0.0.1:5432/radar

# Host `npm run dev` сам зовёт infra:up (Postgres+RMQ+Prometheus+Grafana).
# Ollama: npm run dev -- --llm  или  RADAR_DEV_WITH_LLM=1
# RADAR_DEV_WITH_LLM=
# RADAR_DEV_WITH_LLM_UI=

# --- pgAdmin (docker-compose) ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=radar_pgadmin

# --- Adminer (docker-compose, лёгкий веб-клиент БД) ---
ADMINER_PORT=8080

# --- RabbitMQ (docker-compose, event transport RMQ) ---
RMQ_USER=radar
RMQ_PASSWORD=radar
RMQ_VHOST=radar
RMQ_AMQP_PORT=5672
RMQ_MGMT_PORT=15672

# --- Prometheus / Grafana (docker-compose, метрики RabbitMQ) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# --- Ollama / Open WebUI (docker:dev поднимает ollama в profile app) ---
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=3001
# Host dev / snap с хоста:
# RADAR_LLM_BASE_URL=http://127.0.0.1:11434/v1
# RADAR_LLM_MODEL=qwen2.5:3b
# docker:dev: ollama entrypoint pull в volume radar_ollama_data если модели нет
# RADAR_LLM_GEOCODER_ENABLED=1
# Docker worker-geo override в compose: http://ollama:11434/v1
COLD_UP_WITH_LLM=0
COLD_UP_WITH_LLM_UI=0

# --- Telegram (сессии — только слоты на диске; deploy через worker:session:deploy) ---
# Опционально: свои ключи с https://my.telegram.org
# Если пусто — TEST ONLY api_id из доки tdesktop (ограничен; при API_ID_INVALID — свои ключи)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
TELEGRAM_MTPROXY_HOST=
TELEGRAM_MTPROXY_PORT=
TELEGRAM_MTPROXY_SECRET=

# --- Worker ---
# memory | db (ingest + outbox relay) | fs (parse:report CLI)
RADAR_STORAGE_MODE=memory
RADAR_SESSIONS_DIR=.radar/sessions
RADAR_INGEST_MANIFEST=
RADAR_INGEST_POLL_MS=2000
# HTTP probe worker (GET /status); API читает через GET /api/worker/status
WORKER_PROBE_PORT=3010
# Host probe: 127.0.0.1 (host dev) | 0.0.0.0 (Docker worker-ingest)
WORKER_PROBE_HOST=127.0.0.1
# API: список probe URL через запятую (docker: worker-ingest:3010,...)
# WORKER_PROBE_TARGETS=http://127.0.0.1:3010/status
# Роль worker-процесса: ingest | backfill | parse | geo | tracking.
# Host `npm run dev` запускает отдельный процесс для каждой роли.
RADAR_WORKER_ROLE=ingest

# Runtime tuning в†’ worker.runtime.manifest.json (WORKER__* override)
# Geo enrichers в†’ geo.enrichers.manifest.json (GEO__* override)
# Runners / obs в†’ deployment.manifest.json (DEPLOY__* override)

RADAR_MAP_STATE_TTL_HOURS=24
RADAR_GEO_ARTIFACTS_DIR=

# --- Geocode enrichers (секреты) ---
# Ключ: https://dadata.ru/profile/#info — только в .env
DADATA_TOKEN=

# --- Web: подложка гео-карты (MapLibre) ---
# По умолчанию OpenFreeMap Dark (OSM, без ключа; не tile.openstreetmap.org).
# VITE_MAP_BASEMAP_STYLE=openfreemap
# VITE_MAP_BASEMAP_STYLE=carto
# VITE_MAP_BASEMAP_STYLE=minimal
# VITE_MAP_BASEMAP_STYLE=local
# Локальный TileServer (после cold:up -Tiles): /tiles (Vite proxy, дефолт) или полный URL для отладки
# VITE_MAP_TILES_URL=/tiles
# Vite proxy (host dev — дефолты 127.0.0.1; Docker app — api:3000, tiles:8080)
# VITE_DEV_PROXY_API=http://127.0.0.1:3000
# VITE_DEV_PROXY_TILES=http://127.0.0.1:8081
# VITE_MAP_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# --- Web: лента системных событий (правый нижний угол) ---
# Минимальный уровень: info | warn | warning | error (default: warn — без info о загрузке)
# VITE_APP_LOG_LEVEL=info

# --- Admin bot (HLD) ---
RADAR_ADMIN_BOT_ALLOWED_USER_IDS=

# --- Docker dev stack (compose.app.yml) ---
# Host: npm run dev | npm run dev:prepare
# Docker dev: npm run docker:dev
# Docker prod: npm run docker:prod  (см. docs/docker-prod-stack.md)
API_PORT=3000
WEB_PORT=5173
# Prod UI (nginx): задайте WEB_PORT=8088 для docker:prod
CHOKIDAR_USEPOLLING=1

# --- Manifest в†” Env SSOT (ADR-021) ---
# См. deployment.manifest.json, worker.runtime.manifest.json, geo.enrichers.manifest.json
# Override: PREFIX__nested__path=value (побеждает manifest)

# Deployment (DEPLOY__)
# DEPLOY__infra__obs__dockerize=true
# DEPLOY__infra__obs__mode=service
# DEPLOY__infra__obs__readMode=embedded
# DEPLOY__infra__obs__serviceUrl=http://observability:3020
# DEPLOY__runners__pipelines__parse__schedulingImpl=runner-platform
# DEPLOY__runners__pipelines__tracking__schedulingImpl=runner-platform
# DEPLOY__process__role=parse
# DEPLOY__transport__kind=rmq
# DEPLOY__transport__rmq__url=amqp://radar:radar@127.0.0.1:5672/radar

# Worker runtime (WORKER__)
# WORKER__backfill__pollMs=20000
# WORKER__tracking__enabled=true
# WORKER__parse__poolSize=2

# Geo enrichers (GEO__) — секрет DADATA_TOKEN остаётся в env
# GEO__llm__enabled=0
# GEO__dadata__enabled=1
# GEO__nominatim__minIntervalMs=1100

# --- Self-host OSM tiles (cold:up -Tiles | npm run tiles:sync) ---
TILES_PORT=8081
# Docker-образы tiles-пайплайна (ghcr.io/osmcode/osmium-tool часто denied)
# TILES_OSMIUM_IMAGE=iboates/osmium:latest
# TILES_TILEMAKER_IMAGE=ghcr.io/systemed/tilemaker:master
COLD_UP_WITH_TILES=0
# Подробный вывод CLI-скриптов (cold-up, tiles:sync)
RADAR_CLI_VERBOSE=0
