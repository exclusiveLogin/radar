# Скопируйте в корневой `.env` (файл не коммитится).
# См. docs/getting-started.md

# --- dotenv-vault (опционально: зашифрованный `.env.vault`, ключ вне git) ---
DOTENV_KEY=

# --- Node / API ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (docker-compose + api + worker db mode) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://radar:radar@127.0.0.1:5432/radar

# --- pgAdmin (docker-compose) ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=radar_pgadmin

# --- Adminer (docker-compose, лёгкий веб-клиент БД) ---
ADMINER_PORT=8080

# --- Ollama / Open WebUI (docker compose --profile llm | llm-ui) ---
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=3001
COLD_UP_WITH_LLM=0
COLD_UP_WITH_LLM_UI=0

# --- Telegram (сессии — только слоты на диске; deploy через worker:session:deploy) ---
# Опционально: свои ключи с https://my.telegram.org
# Если пусто — TEST ONLY api_id из доки tdesktop (ограничен; при API_ID_INVALID — свои ключи)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
TELEGRAM_MTPROXY_HOST=
TELEGRAM_MTPROXY_PORT=
TELEGRAM_MTPROXY_SECRET=

# --- Worker ---
# memory | db (ingest + outbox relay) | fs (parse:report CLI)
RADAR_STORAGE_MODE=memory
RADAR_SESSIONS_DIR=.radar/sessions
RADAR_INGEST_MANIFEST=
RADAR_INGEST_POLL_MS=2000
# HTTP probe worker (GET /status); API читает через GET /api/worker/status
WORKER_PROBE_PORT=3010

# Backfill V2 (db mode, демон ingest_backfill_jobs)
RADAR_BACKFILL_POLL_MS=15000
RADAR_BACKFILL_DAEMON_ENABLED=1

# После completed phase_run — POST /api/map/push-snapshot (WS snapshot клиентам). 0 = выкл
RADAR_MAP_SNAPSHOT_AFTER_PHASE=1

# Phase-pipeline v2 (db mode): scheduled-фазы llm/dadata/…
# RADAR_PHASE_DAEMON_ENABLED=1
# RADAR_PHASE_DAEMON_POLL_MS=15000
# Порядок claim/reparse: desc (по умолчанию, сначала свежие) | asc
# RADAR_PHASE_CLAIM_ORDER=desc

# TTL статусов карты (read-line fold): окно фактов
RADAR_MAP_STATE_TTL_HOURS=24

# Parse в worker_threads (db mode)
RADAR_PARSE_USE_WORKER_THREADS=1
RADAR_PARSE_WORKER_POOL_SIZE=2

# Порядок шагов внутри фазы (finalizer: coords dadata > llm)
# RADAR_GEO_PIPELINE_ORDER=catalog,dadata,llm,nominatim
RADAR_GEO_ARTIFACTS_DIR=

# --- Geocode enrichers ---
RADAR_ENRICHER_DADATA_ENABLED=1
RADAR_ENRICHER_NOMINATIM_ENABLED=1
# Ключ: https://dadata.ru/profile/#info — только в .env, не в git
DADATA_TOKEN=
# Nominatim (OSM): публичный API ~1 req/s — пауза между HTTP в geo-nominatim / ingest nominatim
RADAR_NOMINATIM_MIN_INTERVAL_MS=1100
# Пауза после HTTP 429 (экспоненциально x2, max RADAR_NOMINATIM_429_MAX_BACKOFF_MS)
RADAR_NOMINATIM_429_BACKOFF_MS=15000
# RADAR_NOMINATIM_429_MAX_BACKOFF_MS=120000
# RADAR_NOMINATIM_429_MAX_RETRIES=4
# RADAR_NOMINATIM_USER_AGENT=radar-worker/0.1 (your-email@example.com)
# LLM (Ollama). На Windows при установленном Ollama Desktop — конфликт 127.0.0.1:11434; см. OLLAMA_PORT.
# OLLAMA_PORT=11435
RADAR_LLM_GEOCODER_ENABLED=0
RADAR_LLM_PROVIDER=ollama
RADAR_LLM_BASE_URL=http://127.0.0.1:11434/v1
RADAR_LLM_MODEL=qwen2.5:3b
RADAR_LLM_TIMEOUT_MS=5000
RADAR_LLM_MAX_TOKENS=220
RADAR_LLM_TEMPERATURE=0
RADAR_LLM_JSON_MODE=1
RADAR_LLM_RETRY_COUNT=1

# --- Web: подложка гео-карты (MapLibre) ---
# По умолчанию OpenFreeMap Dark (OSM, без ключа; не tile.openstreetmap.org).
# VITE_MAP_BASEMAP_STYLE=openfreemap
# VITE_MAP_BASEMAP_STYLE=carto
# VITE_MAP_BASEMAP_STYLE=minimal
# VITE_MAP_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# --- Web: лента системных событий (правый нижний угол) ---
# Минимальный уровень: info | warn | warning | error (default: warn — без info о загрузке)
# VITE_APP_LOG_LEVEL=info

# --- Admin bot (HLD) ---
RADAR_ADMIN_BOT_ALLOWED_USER_IDS=
