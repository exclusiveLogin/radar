{
  "annotations": { "list": [] },
  "description": "Ollama (cAdvisor/health) + NVIDIA GPU (nvidia_smi_*) + LLM enricher/validator (radar_llm_*).",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "-2": { "color": "dark-red", "text": "stopped" },
                "-1": { "color": "orange", "text": "unknown" },
                "0": { "color": "red", "text": "unhealthy" },
                "1": { "color": "yellow", "text": "no probe" },
                "2": { "color": "green", "text": "healthy" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max(docker_container_health_status{compose_service=\"ollama\"}) or vector(-1)",
          "instant": true,
          "legendFormat": "ollama",
          "refId": "A"
        }
      ],
      "title": "Ollama health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "avg(nvidia_smi_utilization_gpu_ratio) * 100",
          "legendFormat": "GPU",
          "refId": "A"
        }
      ],
      "title": "GPU util",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 12000000000 },
              { "color": "red", "value": 15000000000 }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 13,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(nvidia_smi_memory_used_bytes)",
          "legendFormat": "VRAM",
          "refId": "A"
        }
      ],
      "title": "VRAM used",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 14,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max(nvidia_smi_temperature_gpu)",
          "legendFormat": "temp",
          "refId": "A"
        }
      ],
      "title": "GPU temp",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(rate(radar_llm_requests_total{outcome=\"ok\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "ok/s",
          "refId": "A"
        }
      ],
      "title": "LLM ok rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(rate(radar_llm_requests_total{outcome=~\"transport|json|schema\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "hard-fail/s",
          "refId": "A"
        }
      ],
      "title": "LLM hard-fail rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "id": 15,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "nvidia_smi_utilization_gpu_ratio * 100",
          "legendFormat": "util {{uuid}}",
          "refId": "A"
        }
      ],
      "title": "GPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "id": 16,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "nvidia_smi_memory_used_bytes",
          "legendFormat": "used {{uuid}}",
          "refId": "A"
        },
        {
          "expr": "nvidia_smi_memory_total_bytes",
          "legendFormat": "total {{uuid}}",
          "refId": "B"
        }
      ],
      "title": "VRAM",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "celsius" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 17,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "nvidia_smi_temperature_gpu",
          "legendFormat": "temp {{uuid}}",
          "refId": "A"
        }
      ],
      "title": "GPU temperature",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "watt" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 18,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "nvidia_smi_power_draw_watts",
          "legendFormat": "power {{uuid}}",
          "refId": "A"
        }
      ],
      "title": "GPU power",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{image!=\"\",container_label_com_docker_compose_service=\"ollama\"}[$__rate_interval])) * 100",
          "legendFormat": "ollama",
          "refId": "A"
        }
      ],
      "title": "Ollama CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{image!=\"\",container_label_com_docker_compose_service=\"ollama\"})",
          "legendFormat": "working set",
          "refId": "A"
        }
      ],
      "title": "Ollama memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 30 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (op, outcome) (rate(radar_llm_requests_total[$__rate_interval]))",
          "legendFormat": "{{op}}/{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "LLM requests by op/outcome",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 30 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (verdict) (rate(radar_llm_validator_verdicts_total[$__rate_interval]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ],
      "title": "Validator verdicts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, op) (rate(radar_llm_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{op}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, op) (rate(radar_llm_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{op}}",
          "refId": "B"
        }
      ],
      "title": "LLM latency (wall)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "-2": { "color": "dark-red", "text": "stopped" },
                "-1": { "color": "orange", "text": "unknown" },
                "0": { "color": "red", "text": "unhealthy" },
                "1": { "color": "yellow", "text": "no probe" },
                "2": { "color": "green", "text": "healthy" }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 50 },
      "id": 11,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "always"
      },
      "targets": [
        {
          "expr": "max by (compose_service) (docker_container_health_status{compose_service=\"ollama\"})",
          "legendFormat": "{{compose_service}}",
          "refId": "A"
        }
      ],
      "title": "Ollama health timeline",
      "type": "state-timeline"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["radar", "llm", "ollama", "gpu", "geo"],
  "time": { "from": "now-3h", "to": "now" },
  "title": "Radar — LLM / Ollama",
  "uid": "radar-llm-ollama",
  "version": 2
}
