{
  "annotations": { "list": [] },
  "description": "Ollama container (cAdvisor/health) + LLM enricher / validator (radar_llm_* с worker-geo/parse).",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "-2": { "color": "dark-red", "text": "stopped" },
                "-1": { "color": "orange", "text": "unknown" },
                "0": { "color": "red", "text": "unhealthy" },
                "1": { "color": "yellow", "text": "no probe" },
                "2": { "color": "green", "text": "healthy" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max(docker_container_health_status{compose_service=\"ollama\"}) or vector(-1)",
          "instant": true,
          "legendFormat": "ollama",
          "refId": "A"
        }
      ],
      "title": "Ollama health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{image!=\"\",container_label_com_docker_compose_service=\"ollama\"}[$__rate_interval])) * 100",
          "legendFormat": "CPU",
          "refId": "A"
        }
      ],
      "title": "Ollama CPU",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 8589934592 },
              { "color": "red", "value": 17179869184 }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{image!=\"\",container_label_com_docker_compose_service=\"ollama\"})",
          "legendFormat": "RAM",
          "refId": "A"
        }
      ],
      "title": "Ollama RAM",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(rate(radar_llm_requests_total{outcome=\"ok\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "ok/s",
          "refId": "A"
        }
      ],
      "title": "LLM ok rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(rate(radar_llm_requests_total{outcome=~\"transport|json|schema\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "hard-fail/s",
          "refId": "A"
        }
      ],
      "title": "LLM hard-fail rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{image!=\"\",container_label_com_docker_compose_service=\"ollama\"}[$__rate_interval])) * 100",
          "legendFormat": "ollama",
          "refId": "A"
        }
      ],
      "title": "Ollama CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{image!=\"\",container_label_com_docker_compose_service=\"ollama\"})",
          "legendFormat": "working set",
          "refId": "A"
        }
      ],
      "title": "Ollama memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 14 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (op, outcome) (rate(radar_llm_requests_total[$__rate_interval]))",
          "legendFormat": "{{op}}/{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "LLM requests by op/outcome",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 14 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (verdict) (rate(radar_llm_validator_verdicts_total[$__rate_interval]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ],
      "title": "Validator verdicts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 24 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, op) (rate(radar_llm_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{op}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, op) (rate(radar_llm_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{op}}",
          "refId": "B"
        }
      ],
      "title": "LLM latency (wall)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "-2": { "color": "dark-red", "text": "stopped" },
                "-1": { "color": "orange", "text": "unknown" },
                "0": { "color": "red", "text": "unhealthy" },
                "1": { "color": "yellow", "text": "no probe" },
                "2": { "color": "green", "text": "healthy" }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "id": 11,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "always"
      },
      "targets": [
        {
          "expr": "max by (compose_service) (docker_container_health_status{compose_service=\"ollama\"})",
          "legendFormat": "{{compose_service}}",
          "refId": "A"
        }
      ],
      "title": "Ollama health timeline",
      "type": "state-timeline"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["radar", "llm", "ollama", "geo"],
  "time": { "from": "now-3h", "to": "now" },
  "title": "Radar — LLM / Ollama",
  "uid": "radar-llm-ollama",
  "version": 1
}
