{
  "annotations": { "list": [] },
  "description": "Ingest/backfill: host heartbeat + transport/domain events. Workload obs для этих ролей не реализован (ADR-017) — только host + wiring.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max(radar_obs_host_last_seen_seconds{role=\"ingest\"})",
          "instant": true,
          "legendFormat": "ingest age",
          "refId": "A"
        }
      ],
      "title": "Ingest host heartbeat age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max(radar_obs_host_last_seen_seconds{role=\"backfill\"})",
          "instant": true,
          "legendFormat": "backfill age",
          "refId": "A"
        }
      ],
      "title": "Backfill host heartbeat age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(rate(radar_transport_messages_total{role=~\"ingest|backfill\",result=\"ack\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "ack/s",
          "refId": "A"
        }
      ],
      "title": "RMQ ack rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(rate(radar_transport_messages_total{role=~\"ingest|backfill\",result=\"nack\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "nack/s",
          "refId": "A"
        }
      ],
      "title": "RMQ nack rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "radar_obs_host_last_seen_seconds{role=~\"ingest|backfill\"}",
          "legendFormat": "{{role}}/{{host_id}}",
          "refId": "A"
        }
      ],
      "title": "Host heartbeat age",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (role, event_type) (rate(radar_worker_domain_events_total{role=~\"ingest|backfill\"}[$__rate_interval]))",
          "legendFormat": "{{role}}/{{event_type}}",
          "refId": "A"
        }
      ],
      "title": "Domain events",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 14, "w": 12, "x": 0, "y": 16 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (role, routing_key, result) (rate(radar_transport_messages_total{role=~\"ingest|backfill\"}[$__rate_interval]))",
          "legendFormat": "{{role}}/{{routing_key}}/{{result}}",
          "refId": "A"
        }
      ],
      "title": "RMQ consume rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 14, "w": 12, "x": 12, "y": 16 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, role, routing_key) (rate(radar_transport_message_duration_seconds_bucket{role=~\"ingest|backfill\"}[$__rate_interval])))",
          "legendFormat": "p95 {{role}}/{{routing_key}}",
          "refId": "A"
        }
      ],
      "title": "RMQ consume latency p95",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["radar", "ingest", "backfill"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "Radar — Ingest / Backfill",
  "uid": "radar-ingest-backfill",
  "version": 1
}
