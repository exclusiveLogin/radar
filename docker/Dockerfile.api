# syntax=docker/dockerfile:1
# Production API: dist запечён в image, без bind-mount исходников.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api/package.json packages/api/
COPY packages/observability/package.json packages/observability/
COPY packages/persistence/package.json packages/persistence/
COPY packages/transport-rmq/package.json packages/transport-rmq/
COPY packages/monorepo-root/package.json packages/monorepo-root/
RUN npm ci \
  --workspace=@radar/api \
  --workspace=@radar/shared \
  --workspace=@radar/observability \
  --workspace=@radar/persistence \
  --workspace=@radar/transport-rmq \
  --workspace=@repo/root \
  --include-workspace-root

FROM deps AS build
COPY packages/shared packages/shared
COPY packages/observability packages/observability
COPY packages/persistence packages/persistence
COPY packages/transport-rmq packages/transport-rmq
COPY packages/monorepo-root packages/monorepo-root
COPY packages/api packages/api
COPY tsconfig.base.json tsconfig.base.json
RUN npm run build -w @radar/shared \
  && npm run build -w @radar/observability \
  && npm run build -w @radar/persistence \
  && npm run build -w @radar/transport-rmq \
  && npm run build -w @repo/root \
  && npm run build -w @radar/api

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api/package.json packages/api/
COPY packages/observability/package.json packages/observability/
COPY packages/persistence/package.json packages/persistence/
COPY packages/transport-rmq/package.json packages/transport-rmq/
COPY packages/monorepo-root/package.json packages/monorepo-root/
RUN npm ci \
  --workspace=@radar/api \
  --workspace=@radar/shared \
  --workspace=@radar/observability \
  --workspace=@radar/persistence \
  --workspace=@radar/transport-rmq \
  --workspace=@repo/root \
  --include-workspace-root \
  --omit=dev
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/packages/observability/dist packages/observability/dist
COPY --from=build /app/packages/persistence/dist packages/persistence/dist
COPY --from=build /app/packages/transport-rmq/dist packages/transport-rmq/dist
COPY --from=build /app/packages/monorepo-root/dist packages/monorepo-root/dist
COPY --from=build /app/packages/api/dist packages/api/dist
COPY deployment.manifest.json ./
# Контуры субъектов (regions-geojson) и geo catalog — runtime read из MONOREPO_ROOT/data
COPY data/geo data/geo
EXPOSE 3000
CMD ["node", "packages/api/dist/main.js"]
