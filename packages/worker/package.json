{
  "name": "@radar/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @radar/shared && npm run build -w @radar/api && npm run build -w @radar/worker",
    "prestart": "npm run predev",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "parse:snap": "tsx src/cli/parseSnap.ts",
    "parse:snap:ollama": "tsx src/cli/parseSnapOllama.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "parse:report": "tsx src/cli/parseReport.ts",
    "parse:ab": "tsx src/cli/parseAb.ts",
    "parse:golden:bootstrap": "tsx src/cli/goldenBootstrap.ts",
    "parse:score": "tsx src/cli/parseScore.ts",
    "worker:session:deploy": "tsx src/cli/sessionCli.ts deploy",
    "worker:session:probe": "tsx src/cli/sessionCli.ts probe",
    "worker:session:invalidate": "tsx src/cli/sessionCli.ts invalidate",
    "ingest:manifest:import": "tsx src/cli/ingestManifestCli.ts import",
    "ingest:manifest:export": "tsx src/cli/ingestManifestCli.ts export",
    "phase:manifest:import": "tsx src/cli/phaseManifestCli.ts import",
    "phase:manifest:export": "tsx src/cli/phaseManifestCli.ts export",
    "parse-engine:rebuild": "tsx src/cli/reparseRawCli.ts",
    "parse-engine:rebuild:drain": "tsx src/cli/reparseRawCli.ts -- --drain-scheduled",
    "parse-engine:reset": "tsx src/cli/pipelineResetCli.ts",
    "parse-engine:clear": "tsx src/cli/clearArchiveCli.ts",
    "parse-engine:clear:raw": "tsx src/cli/clearRawCli.ts",
    "parse-engine:clear:ingest": "tsx src/cli/clearIngestCli.ts",
    "parse-engine:drain": "npm run parse-engine:ingest:drain && npm run parse-engine:geo:drain",
    "parse-engine:status": "tsx src/cli/parseEngineStatusCli.ts",
    "parse-engine:queue:ingest": "tsx src/cli/parseEngineStatusCli.ts ingest",
    "parse-engine:queue:geo": "tsx src/cli/parseEngineStatusCli.ts geo",
    "parse-engine:runs:status": "tsx src/cli/parseEngineStatusCli.ts runs",
    "parse-engine:ingest:drain": "tsx src/cli/ingestScheduledDrainCli.ts",
    "parse-engine:ingest:backfill": "tsx src/cli/ingestBackfillCli.ts",
    "worker:ingest:backfill": "tsx src/cli/ingestBackfillCli.ts",
    "parse-engine:geo:drain": "tsx src/cli/placeEnrichmentDrainCli.ts",
    "parse-engine:geo:check": "tsx src/cli/geoDadataCheckCli.ts",
    "parse-engine:geo:recover": "tsx src/cli/geoRecoverCli.ts",
    "parse-engine:catalog:heal": "tsx src/cli/placeCatalogHealCli.ts",
    "parse-engine:catalog:heal:audit": "tsx src/cli/placeCatalogHealAuditCli.ts",
    "parse-engine:catalog:purge-garbage": "tsx src/cli/placeCatalogPurgeGarbageCli.ts",
    "parse-engine:catalog:sweep": "tsx src/cli/placeCatalogSweepCli.ts",
    "parse-engine:catalog:wipe": "tsx src/cli/catalogPlacesWipeCli.ts",
    "parse-engine:system:wipe": "tsx src/cli/systemFullResetCli.ts",
    "phase:lifecycle": "tsx src/cli/phaseLifecycleCli.ts",
    "parse-engine:phase:run": "tsx src/cli/phaseRunCli.ts",
    "parse-engine:phase:stop": "tsx src/cli/phaseRunsStopAllCli.ts",
    "parse-engine:manifest:import": "tsx src/cli/phaseManifestCli.ts import",
    "parse-engine:manifest:export": "tsx src/cli/phaseManifestCli.ts export",
    "worker:map-state:expire": "tsx src/cli/mapStateExpireCli.ts",
    "worker:backfill:status-read-models": "tsx src/cli/backfillStatusReadModelsCli.ts",
    "verify:parse-threads": "tsx scripts/verify-parse-threads.mjs",
    "verify:bootstrap": "tsx scripts/verify-worker-bootstrap.mjs"
  },
  "dependencies": {
    "@radar/shared": "*",
    "cli-progress": "^3.12.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "telegram": "npm:teleproto@^1.225.3",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
