{
  "name": "@radar/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @radar/shared && npm run build -w @radar/api && npm run build -w @radar/worker",
    "prestart": "npm run predev",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "parse:snap": "tsx src/cli/parseSnap.ts",
    "parse:snap:ollama": "tsx src/cli/parseSnapOllama.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "parse:report": "tsx src/cli/parseReport.ts",
    "parse:ab": "tsx src/cli/parseAb.ts",
    "parse:golden:bootstrap": "tsx src/cli/goldenBootstrap.ts",
    "parse:score": "tsx src/cli/parseScore.ts",
    "worker:session:deploy": "tsx src/cli/sessionCli.ts deploy",
    "worker:session:probe": "tsx src/cli/sessionCli.ts probe",
    "worker:session:invalidate": "tsx src/cli/sessionCli.ts invalidate",
    "ingest:manifest:import": "tsx src/cli/ingestManifestCli.ts import",
    "ingest:manifest:export": "tsx src/cli/ingestManifestCli.ts export",
    "phase:manifest:import": "tsx src/cli/phaseManifestCli.ts import",
    "phase:manifest:export": "tsx src/cli/phaseManifestCli.ts export",
    "worker:ingest:backfill": "tsx src/cli/ingestBackfillCli.ts",
    "worker:reparse:raw": "tsx src/cli/reparseRawCli.ts",
    "worker:enrich:run": "tsx src/cli/enrichRunCli.ts",
    "worker:phase:run": "tsx src/cli/phaseRunCli.ts",
    "worker:backfill:place-status-history": "tsx src/cli/backfillPlaceStatusHistoryCli.ts",
    "worker:map-state:expire": "tsx src/cli/mapStateExpireCli.ts",
    "verify:parse-threads": "tsx scripts/verify-parse-threads.mjs",
    "verify:bootstrap": "tsx scripts/verify-worker-bootstrap.mjs"
  },
  "dependencies": {
    "@radar/shared": "*",
    "cli-progress": "^3.12.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "telegram": "^2.26.22",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
