{
  "name": "@radar/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./deployment/deploymentManifest.loader.js": {
      "types": "./dist/deployment/deploymentManifest.loader.d.ts",
      "default": "./dist/deployment/deploymentManifest.loader.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0"
  },
  "dependencies": {
    "@turf/bearing": "^7.3.5",
    "@turf/distance": "^7.3.5",
    "@turf/helpers": "^5.1.5",
    "cli-progress": "^3.12.0",
    "h3-js": "^4.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "typescript": "^5.7.2"
  }
}
